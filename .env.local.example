# Copy this file to .env.local and fill in the values from:
# https://app.supabase.com → your project → Project Settings → API

# Public keys – safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret key – server-only, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Admin password for /admin/learn moderation dashboard
ADMIN_SECRET=choose-a-strong-password
